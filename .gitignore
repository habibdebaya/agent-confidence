# Only the listed paths are eligible for tracking.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/Makefile
!/pyproject.toml
!/config.yaml
!/Dockerfile
!/docker-compose.yml
!/.github/
!/app/
!/crawl/
!/trustlayer/
!/eval/
!/sim/
!/tests/
!/docs/
!/data/

# Application source and the assets used by the public demonstration.
/app/*
!/app/*.py
!/app/static/
/app/static/*
!/app/static/index.html
!/app/static/technical-report.html
!/app/static/site.css
!/app/static/site.js
!/app/static/report.js
!/app/static/data/
/app/static/data/*
!/app/static/data/snapshot.json
!/app/static/data/catalogue.json
!/app/static/data/evidence.json

# Collection, scoring, reconstruction, and experiment source.
/crawl/*
!/crawl/*.py
/trustlayer/*
!/trustlayer/*.py
/eval/*
!/eval/*.py
/sim/*
!/sim/*.py
/tests/*
!/tests/test_*.py
!/tests/browser_confidence.cjs

# Public documentation and the fixed funding-label input.
/docs/*
!/docs/data.md
!/docs/technical-report.md
!/docs/preview.png
/data/*
!/data/external_roots.csv
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml

# Credentials, local guidance, and generated files remain excluded everywhere.
.env
.env.*
!.env.example
AGENTS.md
.local/
.agents/
.codex/
erc8004-private/
__pycache__/
*.py[cod]
*.parquet
*.log
*.tmp
*.bak
.DS_Store
